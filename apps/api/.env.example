# Copy to .env and fill in. Never commit .env — it is gitignored.

# App
PORT=3001
NODE_ENV=development

# Database — local development.
# Hosted platforms (Railway, Render) inject DATABASE_URL instead; when that is
# set it wins and everything below is ignored.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=jericho_school
# DATABASE_URL=postgresql://user:password@host:5432/jericho_school

# Schema management.
#
# Migrations are the supported way to create and change the schema:
#   npm run migration:run
#
# SYNCHRONIZE_DB lets TypeORM alter and DROP columns to match the entities.
# It is off unless set to exactly "true". Never enable it against the school's
# live database — it will silently destroy data.
# SYNCHRONIZE_DB=false
#
# Set RUN_MIGRATIONS=true to apply pending migrations automatically on boot.
# Useful on Railway/Render where there is no shell step in the deploy.
# RUN_MIGRATIONS=true

# JWT — generate a long random value for production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=2h

# Allowed browser origins for CORS, comma-separated.
# Must match where the frontend is actually served from — a mismatch here is
# what makes the login screen show "Failed to fetch".
# Local Vite dev server:
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# FRONTEND_URL=https://jerichoschool.ac.rw
