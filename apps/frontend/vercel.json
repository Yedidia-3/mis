{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "installCommand": "npm --prefix apps/frontend install",
  "buildCommand": "npm --prefix apps/frontend run build",
  "outputDirectory": "apps/frontend/dist",
  "framework": "vite",

  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
