# Copy to .env and fill in. Never commit .env — it is gitignored.

# Base URL of the API, with no trailing slash.
#
# Vite inlines this at BUILD time, not run time. Changing it on the hosting
# platform therefore requires a fresh deploy to take effect.
#
# Local development: optional — the app falls back to http://127.0.0.1:3001
# when this is unset and the dev server is running.
#
# Production: REQUIRED. The build throws without it, by design, so a
# misconfigured deploy fails loudly instead of silently calling localhost.
#
# On Vercel: Settings → Environment Variables → add VITE_API_URL, then redeploy.
VITE_API_URL=http://127.0.0.1:3001
